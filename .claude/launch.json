{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "playrates",
            "runtimeExecutable": "sh",
            "runtimeArgs": [
                "-c",
                "npx concurrently -k -n frontend,backend -c cyan,magenta \"npm run dev -w frontend\" \"PORT=3000 CORS_ORIGINS=http://localhost:${PORT:-5173} npm run dev -w backend\""
            ],
            "port": 5173,
            "autoPort": true
        },
        {
            "name": "playrates-api",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev",
                "-w",
                "backend"
            ],
            "port": 3000
        },
        {
            "name": "playrates-local",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:local"
            ],
            "port": 5173,
            "autoPort": true
        },
        {
            "name": "playrates-local-keep",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "scripts/dev-local.mjs",
                "--keep"
            ],
            "port": 5173,
            "autoPort": true
        }
    ]
}
