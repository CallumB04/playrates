{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build -w @playrates/shared && npm run build -w frontend",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
