{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build -w @playrates/shared && npm run build -w frontend",
    "outputDirectory": "frontend/dist",
    "regions": [
        "fra1"
    ],
    "functions": {
        "api/index.ts": {
            "maxDuration": 60,
            "includeFiles": "{frontend/dist/index.html,node_modules/@fontsource/geist/files/geist-latin-*-normal.woff,node_modules/harfbuzzjs/hb.wasm}"
        },
        "api/cron.ts": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron?job=trending",
            "schedule": "0 5 * * *"
        },
        {
            "path": "/api/cron?job=nudges",
            "schedule": "0 17 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/((?!cron$).*)",
            "destination": "/api"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/api"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.igdb.com https://byctkyrrrtosivvzfrro.supabase.co; font-src 'self'; connect-src 'self' https://byctkyrrrtosivvzfrro.supabase.co wss://byctkyrrrtosivvzfrro.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=()"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        },
        {
            "source": "/assets/:file([^/]+-[A-Za-z0-9_-]{8}\\.[a-z0-9]+)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
