{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build -w @playrates/shared && npm run build -w frontend",
    "outputDirectory": "frontend/dist",
    "functions": {
        "api/index.ts": {
            "includeFiles": "frontend/dist/index.html"
        }
    },
    "crons": [
        {
            "path": "/api/v1/cron/trending",
            "schedule": "0 5 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/game/:id",
            "destination": "/api"
        },
        {
            "source": "/user/:username",
            "destination": "/api"
        },
        {
            "source": "/community/thread/:id",
            "destination": "/api"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api"
        },
        {
            "source": "/sitemaps/:file",
            "destination": "/api"
        },
        {
            "source": "/robots.txt",
            "destination": "/api"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://byctkyrrrtosivvzfrro.supabase.co wss://byctkyrrrtosivvzfrro.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=()"
                }
            ]
        }
    ]
}
