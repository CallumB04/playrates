{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "seed:games": "tsx scripts/seedGames.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "migrate:igdb": "tsx scripts/migrateToIgdb.ts",
    "local:snapshot": "tsx scripts/local/snapshot.ts",
    "local:seed": "tsx scripts/local/buildSeed.ts",
    "backfill:progress": "tsx scripts/backfillProgress.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "description": "PlayRates backend API",
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@playrates/shared": "*",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.47.10",
    "@upstash/redis": "^1.40.0",
    "@vercel/functions": "^3.10.4",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.6",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.15.0",
    "globals": "^17.13.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
