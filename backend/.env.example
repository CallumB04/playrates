PORT=3000

# Node environment: development | production | test
NODE_ENV=development

CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A Twitch developer app (dev.twitch.tv/console); IGDB signs in through it.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Vercel sends it on each scheduled job; jobs are refused without it.
CRON_SECRET=

# Email. Without RESEND_API_KEY emails are only logged (or go to Mailpit
# when MAILPIT_URL is set). The key needs full access: contacts and
# broadcasts are refused to a sending-only one.
RESEND_API_KEY=
# The segment news emails go to (Resend: Audience > Segments).
RESEND_SEGMENT_ID=
# The webhook's signing secret, whsec_...
RESEND_WEBHOOK_SECRET=
# Any long random string. Nothing with an unsubscribe link is sent without it.
EMAIL_SIGNING_SECRET=
EMAIL_FROM=PlayRates <hello@playrates.app>
# Where links in emails point, and the API as a mail app reaches it.
SITE_URL=https://playrates.app
PUBLIC_API_URL=https://playrates.app/api/v1
# The local stack's mail viewer; every email goes there instead.
MAILPIT_URL=
# Where emails load their own pictures and fonts. Leave empty for the live
# site; the local stack sets it to the app it runs.
EMAIL_ASSETS_URL=

# Upstash Redis (upstash.com, or Vercel's Upstash integration, which names
# them KV_REST_API_URL and KV_REST_API_TOKEN). Rate limits count there so
# every instance shares one count; without it each instance counts alone.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push. Generate a pair with: npx web-push generate-vapid-keys
# Without both, nothing is pushed and Settings does not offer it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
