# ---------------------------------------------------------------------------
# Backend environment variables
#
# Copy this file to `.env` and fill in the values.
#   cp backend/.env.example backend/.env
#
# This file contains SECRETS. `.env` is gitignored — keep it that way.
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The frontend dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Supabase project URL (same value as the frontend's VITE_SUPABASE_URL).
# Supabase dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Supabase SERVICE ROLE key.
# Supabase dashboard -> Project Settings -> API Keys -> service_role
#
# !! SECRET !!  This key bypasses Row Level Security and can read and write
# every table. It must never be sent to the browser, committed, or prefixed
# with VITE_. Backend only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# RAWG games API
# ---------------------------------------------------------------------------

# Get a free key at https://rawg.io/apidocs (sign up, then it is shown
# immediately on that page).
RAWG_API_KEY=
